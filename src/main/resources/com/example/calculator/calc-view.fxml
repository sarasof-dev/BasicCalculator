<VBox fx:id="base" alignment="CENTER" prefHeight="655.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #E8EBFF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.calculator.calcController">
